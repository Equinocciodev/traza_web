# Copia este archivo como .env (o define las variables en tu proveedor de despliegue).
# Ninguna de estas variables conecta un dominio ni un proveedor: solo parametrizan el build.

# URL pública canónica del sitio (usada en canonical, Open Graph, sitemap y robots).
PUBLIC_SITE_URL=https://traza-demo.example
# Ruta base si el sitio se sirve bajo un subdirectorio (por ejemplo /demo/).
PUBLIC_BASE_PATH=/

# Modo del adaptador de API: "mock" (fixtures locales, sin red) o "remote" (endpoints reales).
PUBLIC_API_MODE=mock
# Base de los endpoints futuros cuando PUBLIC_API_MODE=remote (sin barra final).
PUBLIC_API_BASE_URL=

# Analítica: "none" (por defecto), "console" (solo desarrollo), "beacon" (POST anónimo, sin cookies,
# a PUBLIC_ANALYTICS_ENDPOINT) o "firebase" (Google Analytics 4 vía SDK de Firebase; SÍ usa cookies).
# En producción se define en las variables de Actions; en local conviene dejarlo en "none".
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_ANALYTICS_ENDPOINT=

# Configuración web de Firebase. Son valores públicos por diseño (viajan en el cliente): la
# protección es restringir la clave por dominio en Google Cloud → Credenciales → Restricciones
# de referente HTTP, no ocultarla. Vacías = la analítica no se activa.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Tenant por defecto de la verificación pública ("traza" = marca maestra).
PUBLIC_DEFAULT_TENANT=traza
# Muestra el ejemplo de co-brand del caso de uso licores (propuesta de piloto).
PUBLIC_SHOW_COBRAND_EXAMPLE=true

# Correo de contacto público (vacío = la página de empresa muestra solo el formulario).
PUBLIC_CONTACT_EMAIL=contacto@traza.technology
# Buzón para la versión en inglés (vacío = se usa el mismo de arriba).
PUBLIC_CONTACT_EMAIL_EN=contact@traza.technology
