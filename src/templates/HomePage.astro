---
import Base from '@/layouts/Base.astro';
import MockDashboard from '@/components/ui/MockDashboard.astro';
import NeonTrace from '@/components/ui/NeonTrace.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import { getContent } from '@/content';
import { HERO_QR_SIZE, HERO_QR_PATH } from '@/brand/hero-qr';
import Icon from '@/components/ui/Icon.astro';
import StoryPlayer from '@/components/story/StoryPlayer.astro';
import { V2_HOME } from '@/content/v2-home';
import { FEATURED_UNIT_CODE, UNIT_BY_CODE } from '@/fixtures/units';
import { route, withBase, type Locale } from '@/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = V2_HOME[locale];
const { common } = getContent(locale);
const featured = UNIT_BY_CODE.get(FEATURED_UNIT_CODE);
if (!featured) throw new Error('The V2 home record requires the existing featured verification fixture.');
const recordHref = `${route(locale, 'verify')}?c=${encodeURIComponent(featured.code)}&t=${featured.tenant}`;
---
<Base locale={locale} routeKey="home" title={t.meta.title} description={t.meta.description} homeV2 bodyClass="home-v2">
  <section class="hero-v3 on-dark" aria-labelledby="home-title">
    <div class="v2-shell hero-v3__inner">
      <div class="hero-v3__copy">
        <Eyebrow>{t.hero.badge}</Eyebrow>
        <h1 id="home-title">{t.hero.title.map((line) => <span>{line}.</span>)}</h1>
        <p class="hero-v3__intro">{t.hero.intro}</p>
        <div class="hero-v3__actions">
          <Button href={`${route(locale, 'company')}#contact-title`} variant="pill" tone="onDark" icon="arrow-right">{common.nav.cta.label}</Button>
          <a class="hero-v3__secondary" href={route(locale, 'verify')}>{t.hero.secondaryAction}<Icon name="arrow-right" size={20} /></a>
        </div>
      </div>
      <div class="hero-v3__visual">
        <div class="hero-v3__neon"><NeonTrace variant="loop" draw="load" /></div>
        <div class="hero-v3__dashboard"><MockDashboard locale={locale} compact /></div>
      </div>
    </div>
  </section>
  <section class="product-v3" aria-labelledby="record-title">
    <div class="v2-shell product-v3__inner">
      <figure class="hero-v2__products">
        <a class="hero-v2__photo-link" href={recordHref} aria-label={t.record.action}>
        <img
          src={withBase('/images/integral-20260909/product.webp')}
          srcset={[480, 768, 1024]
            .map((w) => `${withBase(`/images/integral-20260909/product-${w}.webp`)} ${w}w`)
            .concat(`${withBase('/images/integral-20260909/product.webp')} 1448w`)
            .join(', ')}
          sizes="(max-width: 59.99em) 90vw, 50vw"
          width="1448"
          height="1086"
          alt={t.hero.imageAlt}
          loading="lazy"
          decoding="async"
        />
        </a>
        <figcaption class="product-v3__caption">{t.hero.relationship}</figcaption>
      </figure>
      <aside class="record-v2" aria-labelledby="record-title">
        <h2 id="record-title" class="record-v2__title">{t.record.title}</h2>
        <a class="record-v2__qr-link" href={recordHref} aria-label={t.record.qrLabel}>
          <svg class="record-v2__qr" viewBox={`0 0 ${HERO_QR_SIZE} ${HERO_QR_SIZE}`} aria-hidden="true" focusable="false" shape-rendering="crispEdges">
            <rect width={HERO_QR_SIZE} height={HERO_QR_SIZE} fill="#fff" />
            <path d={HERO_QR_PATH} fill="#07152b" />
          </svg>
          <span>{t.record.qrLabel}</span>
        </a>
        <p class="record-v2__qr-hint">{t.record.qrHint}</p>
        <p class="record-v2__code"><code>{featured.code}</code></p>
        <dl class="record-v2__fields">
          <div><dt>{t.record.productLabel}</dt><dd>{t.record.product}</dd></div>
          <div><dt>{t.record.lotLabel}</dt><dd>{featured.origin.lot}</dd></div>
          <div><dt>{t.record.eventLabel}</dt><dd>{t.record.event}</dd></div>
        </dl>
        <p class="record-v2__disclaimer">{t.record.disclaimer}</p>
        <a class="v2-action v2-action--text record-v2__action" href={recordHref}>{t.record.action}<Icon name="arrow-right" size={22} /></a>
      </aside>
    </div>
  </section>
  <StoryPlayer locale={locale} id="historia" />
  <section class="v2-section" aria-labelledby="perspectives-title">
    <div class="v2-shell">
      <div class="v2-section__intro"><p class="v2-eyebrow">{t.perspectives.eyebrow}</p><h2 id="perspectives-title">{t.perspectives.title}</h2><p>{t.perspectives.intro}</p></div>
      <ol class="perspective-rows">
        {t.perspectives.items.map((item, index) => <li>
          <span class="perspective-rows__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div class="perspective-rows__heading"><Icon name={item.icon} size={24} /><h3>{item.title}</h3></div>
          <p>{item.body}</p><a class="v2-action v2-action--text" href={route(locale, item.key)}>{item.action}<Icon name="arrow-right" size={20} /></a>
        </li>)}
      </ol>
      <p class="v2-note">{t.perspectives.note}</p>
    </div>
  </section>
  <section class="v2-section v2-section--subtle" aria-labelledby="scope-title">
    <div class="v2-shell v2-split">
      <div><p class="v2-eyebrow">{t.scope.eyebrow}</p><h2 id="scope-title">{t.scope.title}</h2></div>
      <div class="v2-split__body">
        <p>{t.scope.body}</p>
        <ul class="scope-links">{t.scope.links.map((link) => <li><a href={route(locale, link.key)}>{link.label}<Icon name="arrow-right" size={20} /></a></li>)}</ul>
        <p class="v2-note">{t.scope.note}</p>
      </div>
    </div>
  </section>
  <section class="v2-section" aria-labelledby="company-title">
    <div class="v2-shell v2-split">
      <div><p class="v2-eyebrow">{t.company.eyebrow}</p><h2 id="company-title">{t.company.title}</h2></div>
      <div class="v2-split__body">
        <p>{t.company.body}</p>
        <div class="company-actions">
          <a class="v2-action v2-action--primary" href={`${route(locale, 'company')}#contact-title`}>{t.company.contact}<Icon name="arrow-right" size={20} /></a>
          <a class="v2-action v2-action--text" href={route(locale, 'company')}>{t.company.action}<Icon name="arrow-right" size={20} /></a>
        </div>
        <p class="v2-note">{t.company.note}</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .v2-shell { width:min(90%,81.25rem); margin-inline:auto; }
  .hero-v3 { background:var(--color-navy-950); overflow:hidden; }
  .hero-v3__inner { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:3rem; padding-block:clamp(4rem,7vw,7rem); align-items:start; }
  .hero-v3__copy { position:relative; z-index:1; }
  .hero-v3 h1 { color:#fff; font-size:clamp(2.4rem,5vw,4.25rem); line-height:1.08; letter-spacing:-.045em; margin:1.6rem 0; max-width:12ch; }
  .hero-v3 h1 > span { display:block; }
  .hero-v3__intro { color:var(--color-neutral-200); font-size:1.125rem; max-width:33ch; line-height:1.65; }
  .hero-v3__actions { display:flex; align-items:flex-start; flex-direction:column; gap:1.1rem; margin-top:2.5rem; }
  .hero-v3__secondary { display:inline-flex; align-items:center; gap:.8rem; color:#fff; min-height:48px; font-size:.875rem; text-decoration:none; }
  .hero-v3__secondary:hover { text-decoration:underline; }
  .hero-v3__visual { display:grid; gap:1.5rem; min-width:0; }
  .hero-v3__neon { width:min(100%,22rem); aspect-ratio:3 / 2; justify-self:center; }
  .hero-v3__dashboard { min-width:0; }
  .product-v3 { padding-block:clamp(4rem,7vw,7rem); background:#fff; }
  .product-v3__inner { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,1fr); align-items:center; gap:4rem; }
  .hero-v2__products { margin:0; min-width:0; }
  .hero-v2__photo-link { display:block; }
  .hero-v2__products img { display:block; width:100%; height:auto; object-fit:contain; }
  .product-v3__caption { margin-top:1rem; color:var(--color-text-secondary); font-size:.875rem; line-height:1.6; }
  .record-v2 { min-width:0; padding:2.2rem; border:1px solid var(--color-border-strong); border-radius:12px; }
  .record-v2__title { margin-bottom:1rem; font-size:clamp(1.6rem,2.5vw,2.2rem); }
  .record-v2__qr-link { display:flex; flex-direction:column; align-items:flex-start; gap:.75rem; width:fit-content; max-width:100%; margin-block:1.25rem; color:var(--color-cobalt-600); text-decoration:none; }
  .record-v2__qr-link:hover span { text-decoration:underline; }
  .record-v2__qr { display:block; width:14rem; max-width:100%; height:auto; aspect-ratio:1; background:#fff; }
  .record-v2__qr-hint { color:var(--color-text-secondary); font-size:.875rem; line-height:1.6; }
  .record-v2__code { padding-bottom:1rem; border-bottom:1px solid var(--color-border); overflow-wrap:anywhere; }
  .record-v2__fields > div { display:grid; grid-template-columns:1fr 1.6fr; gap:.8rem; padding:1rem 0; border-bottom:1px solid var(--color-border); }
  .record-v2__fields dt, .record-v2__disclaimer { color:var(--color-text-secondary); }
  .record-v2__fields dd { margin:0; overflow-wrap:anywhere; }
  .record-v2__disclaimer { font-size:.875rem; margin-top:1.3rem; }
  .v2-action { display:inline-flex; align-items:center; justify-content:center; min-height:48px; gap:.8rem; text-decoration:none; }
  .v2-action--primary { padding:.7rem 1.5rem; border-radius:999px; color:#fff; background:var(--color-cobalt-600); }
  .v2-action--primary:hover { background:var(--color-cobalt-700); color:#fff; }
  .v2-action--text { color:var(--color-cobalt-600); }
  .v2-action--text:hover { text-decoration:underline; }
  .v2-section { padding-block: clamp(4rem, 7vw, 7rem); }
  .v2-section--subtle { background: var(--color-mint-100); }
  .v2-section__intro { max-width: 43rem; margin-bottom: 2.5rem; }
  .v2-eyebrow { color: var(--color-cobalt-600); margin: 0 0 1rem; font-size: 0.875rem; font-weight: 500; letter-spacing: 0.015em; }
  .v2-section h2 { color: var(--color-navy-950); max-width: 18ch; font-size: clamp(2rem, 3.6vw, 3.25rem); line-height: 1.13; letter-spacing: -0.035em; }
  .v2-section__intro > p:last-child, .v2-split__body > p:first-child { color: #4d5d7a; font-size: 1.125rem; line-height: 1.7; }
  .perspective-rows { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin: 0; padding: 0; list-style: none; }
  .perspective-rows > li { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; padding: 2rem 1.75rem; border: 1px solid var(--color-border-strong); border-radius: 10px; background: #fff; overflow: hidden; }
  .perspective-rows__number { position: absolute; top: 1.25rem; right: 1.5rem; color: var(--color-cobalt-600); font-family: var(--font-mono); font-size: 2.5rem; line-height: 1; letter-spacing: -0.04em; }
  .perspective-rows__heading { display: flex; align-items: center; gap: 1rem; color: var(--color-cobalt-600); }
  .perspective-rows h3 { margin: 0; font-size: 1.25rem; letter-spacing: -0.02em; }
  .perspective-rows li > p { flex: 1 1 auto; margin: 0; color: #4d5d7a; font-size: 1rem; line-height: 1.6; }
  .perspective-rows .v2-action { justify-content: flex-start; gap: 0.5rem; text-align: left; }
  .v2-note { max-width: 65ch; margin: 1.75rem 0 0; font-size: 0.9375rem; color: #4d5d7a; line-height: 1.6; }
  .v2-split { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(3rem, 9vw, 8rem); }
  .scope-links { margin: 2rem 0; padding: 0; list-style: none; }
  .scope-links li { border-top: 1px solid var(--color-border-strong); }
  .scope-links li:last-child { border-bottom: 1px solid var(--color-border-strong); }
  .scope-links a { display: flex; align-items: center; justify-content: space-between; min-height: 3.75rem; padding-block: 0.75rem; gap: 1rem; color: var(--color-navy-950); text-decoration: none; }
  .scope-links a:hover { color: var(--color-cobalt-600); }
  .company-actions { display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; margin-top: 2rem; }

  @media(max-width:59.99em) {
    .hero-v3__inner,.product-v3__inner { grid-template-columns:minmax(0,1fr); gap:2rem; }
    .hero-v3 h1 { max-width:18ch; }
    .hero-v3__visual { gap:1rem; }
    .perspective-rows,.v2-split { grid-template-columns:minmax(0,1fr); }
    .v2-split { gap:1.5rem; }
    .record-v2 { padding:1.5rem; }
  }
  @media(max-width:25em) {
    .record-v2__fields > div { grid-template-columns:1fr; gap:.3rem; }
  }
</style>
