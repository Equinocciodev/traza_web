---
/**
 * Cabecera compartida: navegación corporativa o pública según la página.
 * Progressive enhancement: sin JavaScript el menú se muestra expandido (hoja public/nojs.css enlazada desde
 * <noscript>); con JavaScript se pliega en móvil desde el primer pintado (sin salto de maquetación).
 */
import Wordmark from '@/components/ui/Wordmark.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { ctaHref } from '@/components/ui/cta';
import { route, otherLocale, withBase, LOCALE_LABELS, type Locale, type RouteKey } from '@/i18n';
import type { CommonContent, NavItem } from '@/content/types';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  common: CommonContent;
}

const { locale, routeKey, common } = Astro.props;
const other = otherLocale(locale);
const switchHref = route(other, routeKey === 'notFound' ? 'home' : routeKey);
const publicNav = routeKey === 'verify' || routeKey === 'solutionsCitizens';
const navItems = publicNav ? common.nav.publicItems : common.nav.items;

function isCurrent(item: NavItem): boolean {
  return item.key === routeKey || !!item.children?.some((child) => child.key === routeKey);
}
---

<header class:list={['site-header', { 'site-header--public': publicNav }]} data-header data-public-nav={publicNav || undefined}>
  <div class="container site-header__inner">
    <a class="site-header__brand" href={route(locale, 'home')} aria-label={common.nav.homeLinkLabel}>
      <Wordmark size="md" alt={common.brand.wordmarkAlt} />
    </a>

    {/* Rendimiento (CLS): sin JavaScript, la hoja /nojs.css muestra el menú expandido y oculta este botón inerte;
        así el primer pintado con JS ya coincide con el estado final (menú plegado) y nada salta al cargar. */}
    <noscript><link rel="stylesheet" href={withBase('/nojs.css')} /></noscript>
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <Icon name="list" size={22} class="site-header__toggle-open" />
      <Icon name="x" size={22} class="site-header__toggle-close" />
      <span class="visually-hidden" data-nav-toggle-label data-open={common.nav.menuOpen} data-close={common.nav.menuClose}>{common.nav.menuOpen}</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={common.nav.ariaLabel} data-nav>
      <ul class="site-nav__list">
        {
          navItems
            .map((item) => (
              <li class="site-nav__item">
                <a class="site-nav__link" href={route(locale, item.key)} aria-current={item.key === routeKey ? 'page' : undefined} data-current-section={isCurrent(item) || undefined}>
                  {item.label}
                </a>
                {item.children && (
                  <ul class="site-nav__sublist">
                    {item.children.map((child) => (
                      <li>
                        <a class="site-nav__sublink" href={route(locale, child.key)} aria-current={routeKey === child.key ? 'page' : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
        }
      </ul>
      <div class="site-nav__actions">
        {/* Accesibilidad (WCAG 2.5.3): el texto visible forma parte del nombre accesible; la descripción
            del diccionario se añade oculta y en el idioma de la página (el visible lleva su propio lang). */}
        <a class="lang-switch" href={switchHref} hreflang={LOCALE_LABELS[other].htmlLang} data-lang-switch>
          <span lang={LOCALE_LABELS[other].htmlLang}>{common.languageSwitch.switchTo}</span>
          <span class="visually-hidden">, {common.languageSwitch.switchAria}</span>
        </a>
        {!publicNav && <Button href={ctaHref(locale, common.nav.cta)} variant="pill" icon="arrow-right" class="site-nav__cta" data-nav-cta>
          {common.nav.cta.label}
        </Button>}
      </div>
    </nav>
  </div>
</header>

<script>
  import { track } from '@/lib/analytics';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = header?.querySelector<HTMLElement>('[data-nav]');
  const label = header?.querySelector<HTMLElement>('[data-nav-toggle-label]');

  if (header && toggle && nav) {
    header.classList.add('is-enhanced');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      header.classList.toggle('is-menu-open', open);
      if (label) label.textContent = open ? label.dataset.close ?? '' : label.dataset.open ?? '';
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    const mq = window.matchMedia('(min-width: 72em)');
    mq.addEventListener('change', () => setOpen(false));
    nav.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      link.addEventListener('click', () => { if (!mq.matches) setOpen(false); });
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    header.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setOpen(false);
    });

    // Escritorio: Escape cierra el submenú desplegado por hover/foco (WCAG 1.4.13); se rearma al salir del elemento.
    const items = Array.from(header.querySelectorAll<HTMLElement>('.site-nav__item'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mq.matches) {
        items.forEach((item) => {
          if (item.querySelector('.site-nav__sublist')?.contains(document.activeElement)) {
            item.querySelector<HTMLAnchorElement>('.site-nav__link')?.focus();
          }
          item.classList.add('is-dismissed');
        });
      }
    });
    items.forEach((item) => {
      item.addEventListener('mouseleave', () => item.classList.remove('is-dismissed'));
      item.addEventListener('focusout', (event) => {
        if (!(event.relatedTarget instanceof Node) || !item.contains(event.relatedTarget)) item.classList.remove('is-dismissed');
      });
    });

    header.querySelector('[data-lang-switch]')?.addEventListener('click', () => track('language_switch'));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-white);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: min(90%, 81.25rem);
    min-height: 5rem;
    flex-wrap: wrap;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    flex-shrink: 0;
    text-decoration: none;
  }
  .site-header__brand :global(.wordmark) { --wm-size: 2rem; color: var(--color-navy-950); }
  .site-header__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-heading);
  }
  /* Los iconos viven en el componente Icon: se apuntan con :global para que el estilo scoped los alcance */
  .site-header__toggle :global(.site-header__toggle-close) {
    display: none;
  }
  .site-header.is-menu-open .site-header__toggle :global(.site-header__toggle-open) {
    display: none;
  }
  .site-header.is-menu-open .site-header__toggle :global(.site-header__toggle-close) {
    display: inline-block;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.6vw, 2.75rem);
    flex: 1 1 auto;
    justify-content: flex-end;
    flex-wrap: nowrap;
  }
  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.5rem, 1.8vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__item {
    position: relative;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.5rem 0.625rem;
    color: var(--color-navy-950);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }
  .site-nav__link:hover {
    color: var(--color-link);
  }
  .site-nav__link[data-current-section] {
    color: var(--color-link);
    box-shadow: inset 0 -2px 0 var(--color-cyan-400);
  }
  .site-nav__sublist {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-3);
  }
  .site-nav__sublink {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.375rem 0.625rem;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .site-nav__sublink:hover {
    color: var(--color-link);
    background: var(--color-bg-subtle);
  }
  .site-nav__sublink[aria-current='page'] {
    color: var(--color-link);
    font-weight: var(--weight-semibold);
  }
  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }
  .site-nav__actions :global(.site-nav__cta) { min-height: 48px; padding-inline: 1.4rem; white-space: nowrap; font-size: 0.875rem; }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 48px;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    text-decoration: none;
  }
  .lang-switch:hover {
    background: var(--color-bg-subtle);
    color: var(--color-link);
  }

  /* Escritorio: los subenlaces se muestran al pasar el puntero o recibir foco. */
  @media (min-width: 72em) {
    .site-nav__sublist {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 16rem;
      padding: var(--space-2);
      background: var(--color-surface);
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      visibility: hidden;
      opacity: 0;
      transform: translateY(4px);
      pointer-events: none;
      transition: opacity var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
    }
    .site-nav__item:hover .site-nav__sublist,
    .site-nav__item:focus-within .site-nav__sublist {
      visibility: visible;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    /* Escape retira el submenú y devuelve al enlace principal cualquier foco que estuviera dentro.
       visibility saca sus enlaces de la tabulación hasta que el puntero o el foco abandonan el elemento. */
    .site-nav__item.is-dismissed .site-nav__sublist {
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
    }
    .site-nav__sublink {
      display: flex;
      width: 100%;
    }
  }

  /* Móvil: menú plegable desde el primer pintado (sin depender de que el script ya haya corrido: evita el salto
     de maquetación al plegarse). Sin JavaScript, public/nojs.css lo muestra expandido y oculta el botón. */
  @media (max-width: 71.99em) {
    .site-header__inner { position: relative; min-height: 4.5rem; }
    .site-header__brand :global(.wordmark) { --wm-size: 1.8rem; }
    .site-header__toggle {
      display: inline-flex;
    }
    .site-nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      background: var(--color-white);
      padding-block: var(--space-3) var(--space-4);
      border-top: var(--border-width) solid var(--color-border);
      max-height: calc(100svh - 4.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .site-header.is-enhanced .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
    }
    .site-nav.is-open {
      display: flex;
    }
    .site-nav__list, .site-nav__actions {
      flex-shrink: 0;
    }
    .site-nav__list {
      flex-direction: column;
      gap: 0;
    }
    .site-nav__link,
    .site-nav__sublink {
      display: flex;
      width: 100%;
    }
    .site-nav__actions {
      flex-wrap: wrap;
      justify-content: space-between;
      padding-top: var(--space-3);
      border-top: var(--border-width) solid var(--color-border);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__link, .site-nav__sublist { transition: none; }
  }
</style>
