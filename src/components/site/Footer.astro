---
/**
 * Pie del sitio: columnas de enlaces, descargo de responsabilidad, legal, idioma.
 */
import Wordmark from '@/components/ui/Wordmark.astro';
import Icon from '@/components/ui/Icon.astro';
import { route, otherLocale, LOCALE_LABELS, type Locale, type RouteKey } from '@/i18n';
import type { CommonContent } from '@/content/types';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  common: CommonContent;
}
const { locale, routeKey, common } = Astro.props;
const other = otherLocale(locale);
const switchHref = route(other, routeKey === 'notFound' ? 'home' : routeKey);
---

<footer class="site-footer on-dark">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark size="lg" alt={common.brand.wordmarkAlt} class="site-footer__wordmark" />
      <p class="site-footer__tagline">{common.brand.tagline}</p>
      <p class="site-footer__domain mono">{common.brand.domain}</p>
    </div>
    <nav class="site-footer__columns" aria-label={common.footer.columns.map((c) => c.title).join(' · ')}>
      {
        common.footer.columns.map((column) => (
          <div class="site-footer__column">
            <h2 class="site-footer__title">{column.title}</h2>
            <ul class="site-footer__list">
              {column.links.map((link) => (
                <li>
                  <a
                    class="site-footer__link"
                    href={link.key ? route(locale, link.key) : link.href}
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {link.label}
                    {link.external && <span class="visually-hidden"> ({common.a11y.newWindow})</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <div class="container site-footer__bottom">
    <p class="site-footer__disclaimer">{common.footer.disclaimer}</p>
    <div class="site-footer__meta">
      <p class="site-footer__legal">{common.footer.legal}</p>
      {/* Accesibilidad (WCAG 2.5.3): texto visible dentro del nombre accesible; descripción oculta en el idioma de la página */}
      <a class="site-footer__lang" href={switchHref} hreflang={LOCALE_LABELS[other].htmlLang}>
        <Icon name="globe" size={16} />
        <span lang={LOCALE_LABELS[other].htmlLang}>{common.languageSwitch.switchTo}</span>
        <span class="visually-hidden">, {common.languageSwitch.switchAria}</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: var(--space-16) var(--space-20);
    background: var(--color-navy-900);
    color: var(--color-white);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-10);
    grid-template-columns: 1fr;
  }
  @media (min-width: 48em) {
    .site-footer__inner {
      grid-template-columns: minmax(14rem, 1.2fr) 2fr;
    }
  }
  .site-footer__brand :global(.site-footer__wordmark) {
    --wm-size: 2rem;
    color: var(--color-white);
  }
  .site-footer__tagline {
    margin: var(--space-4) 0 var(--space-1);
    font-weight: var(--weight-medium);
  }
  .site-footer__domain {
    font-size: var(--text-sm);
    color: var(--color-cyan-300);
  }
  .site-footer__columns {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }
  .site-footer__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cyan-300);
  }
  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min); /* accesibilidad: target táctil ≥ 44 px (brief §7); antes 2.25rem */
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .site-footer__link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }
  .site-footer__bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    gap: var(--space-4);
  }
  .site-footer__disclaimer {
    max-width: 78ch;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
  }
  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: center;
  }
  .site-footer__legal {
    margin: 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.78);
  }
  .site-footer__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--tap-min);
    color: var(--color-white);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .site-footer__lang:hover {
    text-decoration: underline;
  }
</style>
