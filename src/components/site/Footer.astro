---
/**
 * Pie compacto: marca, enlaces esenciales, recursos y aviso de alcance.
 */
import Wordmark from '@/components/ui/Wordmark.astro';
import Icon from '@/components/ui/Icon.astro';
import { route, otherLocale, LOCALE_LABELS, type Locale, type RouteKey } from '@/i18n';
import type { CommonContent } from '@/content/types';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  common: CommonContent;
}
const { locale, routeKey, common } = Astro.props;
const other = otherLocale(locale);
const switchHref = route(other, routeKey === 'notFound' ? 'home' : routeKey);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark size="lg" alt={common.brand.wordmarkAlt} class="site-footer__wordmark" />
      <p class="site-footer__tagline">{common.brand.tagline}</p>
    </div>
    <nav class="site-footer__columns" aria-label={common.footer.columns.map((c) => c.title).join(' · ')}>
      {
        common.footer.columns.map((column) => (
          <div class="site-footer__column">
            <h2 class="visually-hidden">{column.title}</h2>
            <ul class="site-footer__list">
              {column.links.map((link) => (
                <li>
                  <a
                    class="site-footer__link"
                    href={link.key ? route(locale, link.key) : link.href}
                    {...(link.external
                      ? { target: '_blank', rel: ['noopener', 'noreferrer', link.rel].filter(Boolean).join(' ') }
                      : {})}
                  >
                    {link.label}
                    {link.external && <span class="visually-hidden"> ({common.a11y.newWindow})</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <div class="container site-footer__bottom">
    <p class="site-footer__disclaimer">{common.footer.disclaimer}</p>
    <div class="site-footer__meta">
      <p class="site-footer__legal">{common.footer.legal}</p>
      {/* Accesibilidad (WCAG 2.5.3): texto visible dentro del nombre accesible; descripción oculta en el idioma de la página */}
      <a class="site-footer__lang" href={switchHref} hreflang={LOCALE_LABELS[other].htmlLang}>
        <Icon name="globe" size={16} />
        <span lang={LOCALE_LABELS[other].htmlLang}>{common.languageSwitch.switchTo}</span>
        <span class="visually-hidden">, {common.languageSwitch.switchAria}</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: 2.75rem 1.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-white);
    color: var(--color-navy-950);
  }
  .site-footer > .container { width: min(90%, 81.25rem); }
  .site-footer__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  .site-footer__brand :global(.site-footer__wordmark) { --wm-size: 1.8rem; color: var(--color-navy-950); }
  .site-footer__tagline { margin: 0.75rem 0 0; max-width: 24ch; font-size: 0.8125rem; line-height: 1.6; color: var(--color-text-secondary); }
  .site-footer__columns { display: grid; gap: 0.25rem; }
  .site-footer__list { display: flex; flex-wrap: wrap; column-gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  .site-footer__link { display: inline-flex; align-items: center; min-width: 44px; min-height: 44px; padding-block: 0.5rem; color: var(--color-text-secondary); text-decoration: none; font-size: 0.8125rem; line-height: 1.4; }
  .site-footer__column:first-child .site-footer__link { color: var(--color-navy-950); font-size: 0.9375rem; font-weight: var(--weight-medium); }
  .site-footer__link:hover, .site-footer__lang:hover { color: var(--color-cobalt-600); text-decoration: underline; text-underline-offset: 0.25em; }
  .site-footer__bottom { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border); display: grid; gap: 0.75rem; }
  .site-footer__disclaimer { max-width: 110ch; font-size: 0.75rem; line-height: 1.7; color: var(--color-text-secondary); margin: 0; }
  .site-footer__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; align-items: center; }
  .site-footer__legal { margin: 0; font-size: 0.75rem; color: var(--color-text-secondary); }
  .site-footer__lang { display: inline-flex; align-items: center; gap: 0.375rem; min-height: 44px; color: var(--color-text-secondary); font-size: 0.8125rem; text-decoration: none; }
  @media (min-width: 60em) {
    .site-footer__inner { grid-template-columns: 12rem minmax(0, 1fr); gap: 3rem; }
  }
</style>
