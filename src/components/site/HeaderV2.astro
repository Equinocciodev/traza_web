---
/** Compatibilidad con Inicio: toda la navegación usa el componente compartido. */
import Header from './Header.astro';
import type { Locale } from '@/i18n';
import type { CommonContent } from '@/content/types';
interface Props { locale: Locale; common: CommonContent }
const { locale, common } = Astro.props;
---
<Header locale={locale} routeKey="home" common={common} />
