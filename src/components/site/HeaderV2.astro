---
import Wordmark from '@/components/ui/Wordmark.astro';
import Icon from '@/components/ui/Icon.astro';
import { V2_HOME } from '@/content/v2-home';
import { LOCALE_LABELS, route, type Locale } from '@/i18n';
import type { CommonContent } from '@/content/types';
interface Props { locale: Locale; common: CommonContent }
const { locale, common } = Astro.props;
const { nav } = V2_HOME[locale];
const languages: Locale[] = ['es', 'en'];
---
<header class="header-v2">
  <div class="header-v2__inner">
    <a class="header-v2__brand" href={route(locale, 'home')} aria-label={common.nav.homeLinkLabel}>
      <Wordmark size="lg" alt={common.brand.wordmarkAlt} />
    </a>
    <nav class="header-v2__desktop" aria-label={common.nav.ariaLabel}>
      <ul class="header-v2__links">{nav.map((item) => <li><a href={route(locale, item.key) + (item.anchor ?? '')}>{item.label}</a></li>)}</ul>
      <div class="header-v2__languages" aria-label={locale === 'es' ? 'Idioma' : 'Language'}>
        {languages.map((language, index) => <>
          {index > 0 && <span aria-hidden="true">/</span>}
          <a href={route(language, 'home')} lang={language} hreflang={language} aria-label={LOCALE_LABELS[language].native} aria-current={locale === language ? 'page' : undefined}>{LOCALE_LABELS[language].short}</a>
        </>)}
      </div>
    </nav>
    <details class="header-v2__mobile" data-v2-menu>
      <summary><Icon name="list" size={22} /><span>{locale === 'es' ? 'Menú' : 'Menu'}</span></summary>
      <nav class="header-v2__panel" aria-label={common.nav.ariaLabel}>
        <ul class="header-v2__links">{nav.map((item) => <li><a href={route(locale, item.key) + (item.anchor ?? '')}>{item.label}</a></li>)}</ul>
        <div class="header-v2__languages" aria-label={locale === 'es' ? 'Idioma' : 'Language'}>
          {languages.map((language, index) => <>
            {index > 0 && <span aria-hidden="true">/</span>}
            <a href={route(language, 'home')} lang={language} hreflang={language} aria-label={LOCALE_LABELS[language].native} aria-current={locale === language ? 'page' : undefined}>{LOCALE_LABELS[language].short}</a>
          </>)}
        </div>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-v2-menu]');
  if (menu) {
    const summary = menu.querySelector<HTMLElement>('summary');
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) { menu.open = false; summary?.focus(); }
    });
    menu.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    window.matchMedia('(min-width: 60em)').addEventListener('change', () => { menu.open = false; });
  }
</script>
<style>
  .header-v2 { position: relative; z-index: var(--z-header); background: #fff; color: var(--color-navy-950); }
  .header-v2__inner { width: min(90.2%, 81.25rem); min-height: 5.625rem; margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .header-v2__brand { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .header-v2__desktop { display: flex; align-items: center; gap: clamp(2rem, 7.3vw, 6.5rem); }
  .header-v2__links { display: flex; align-items: center; gap: clamp(1.5rem, 4.2vw, 3.75rem); list-style: none; margin: 0; padding: 0; }
  .header-v2 a { color: var(--color-navy-950); }
  .header-v2__links a { display: flex; align-items: center; min-height: 44px; text-decoration: none; font-size: 1rem; }
  .header-v2__links a:hover, .header-v2__languages a:hover { color: var(--color-cobalt-600); text-decoration: underline; text-underline-offset: 0.3em; }
  .header-v2__languages { display: flex; align-items: center; gap: 0.2rem; font-size: 1rem; color: var(--color-text-secondary); }
  .header-v2__languages a { min-width: 2rem; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; color: var(--color-text-secondary); }
  .header-v2__languages a[aria-current] { color: var(--color-navy-950); font-weight: 600; }
  .header-v2__mobile { display: none; }
  @media (max-width: 59.99em) {
    .header-v2__inner { width: calc(100% - 2.5rem); min-height: 5rem; gap: 1rem; }
    .header-v2__brand :global(.wordmark--lg) { --wm-size: 2rem; }
    .header-v2__desktop { display: none; }
    .header-v2__mobile { display: block; position: relative; }
    .header-v2__mobile summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 44px; padding: 0.35rem 0.625rem; color: var(--color-navy-950); border: 1px solid var(--color-border-strong); border-radius: 4px; font-size: 0.9375rem; }
    .header-v2__mobile summary::-webkit-details-marker { display: none; }
    .header-v2__panel { position: absolute; right: 0; top: calc(100% + 0.75rem); width: min(22rem, calc(100vw - 2.5rem)); padding: 1rem 1.25rem; border: 1px solid var(--color-border-strong); border-radius: 6px; background: #fff; }
    .header-v2__links { display: block; }
    .header-v2__links a { padding-block: 0.375rem; }
    .header-v2__languages { margin-top: 0.75rem; padding-top: 0.5rem; border-top: 1px solid var(--color-border); justify-content: flex-start; }
    .header-v2__languages a { min-width: 44px; }
  }
</style>
