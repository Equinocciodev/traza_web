      <summary class="verify-scenarios__summary">
        <h2 class="verify-panel__title verify-scenarios__title">
          <Icon name="list" size={22} class="verify-panel__icon" />
          {t.scenarios.title}
        </h2>
        <Icon name="arrow-right" size={18} class="verify-scenarios__chevron" />
      </summary>
      <p class="verify-panel__intro">{t.scenarios.intro}</p>
      {
        groups.map((g) => (
          <div class="scenario-group">
            <h3 class="scenario-group__title">{g.title}</h3>
            <ul class="scenario-list">
              {g.items.map((s) => (
