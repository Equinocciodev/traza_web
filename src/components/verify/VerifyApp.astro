---
/**
 * Isla de verificación pública.
 *
 * Progressive enhancement: todo el HTML (contexto de tenant, escáner, entrada manual, escenarios,
 * estructura del resultado, formulario de reporte) se renderiza en servidor. El módulo cliente
 * (./verify.ts) monta el comportamiento encima y solo cambia atributos, texto y visibilidad.
 * Las cadenas dinámicas viajan en un bloque JSON no ejecutable (compatible con CSP estricta).
 * Nunca "auténtico": el resultado explica qué se comprobó, qué confianza aporta y el siguiente paso.
 */
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import StatusPill from '@/components/ui/StatusPill.astro';
import Callout from '@/components/ui/Callout.astro';
import Lockup from '@/components/ui/Lockup.astro';
import QrMotif from '@/components/ui/QrMotif.astro';
import { getContent } from '@/content';
import type { VerifyClientStrings } from '@/content/verify.types';
import { TENANTS } from '@/config/tenants';
import { env } from '@/config/env';
import { SCENARIOS } from '@/fixtures/scenarios';
import { FEATURED_UNIT_CODE } from '@/fixtures/units';
import { route, type Locale } from '@/i18n';
import { CHECK_ORDER } from '@/lib/verify/engine';
import { VERDICT_ICON, VERDICT_TONE, OUTCOME_ICON, SEVERITY_TONE } from '@/lib/verify/present';
import type { Verdict, CheckOutcome } from '@/lib/verify/types';
import type { Severity, DiscrepancyKind } from '@/fixtures/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { verify: t, common } = getContent(locale);

const defaultTenant = TENANTS[env.defaultTenant];
const tenants = Object.values(TENANTS);
const tenantsWithLockup = env.showCobrandExample ? tenants.filter((x) => x.lockup) : [];

const clientStrings: VerifyClientStrings = {
  scanner: t.scanner,
  manual: t.manual,
  scenarios: t.scenarios,
  states: t.states,
  verdicts: t.verdicts,
  reasons: t.reasons,
  checks: t.checks,
  unit: t.unit,
  meaning: t.meaning,
  actions: t.actions,
  report: t.report,
  a11y: t.a11y,
};
// `<` escapado para que ningún texto pueda cerrar el bloque de datos.
const stringsJson = JSON.stringify(clientStrings).replace(/</g, '\\u003c');

const groups = [
  { key: 'code', title: t.scenarios.groups.code, items: SCENARIOS.filter((s) => s.trigger === 'code') },
  { key: 'transport', title: t.scenarios.groups.transport, items: SCENARIOS.filter((s) => s.trigger === 'transport') },
  { key: 'device', title: t.scenarios.groups.device, items: SCENARIOS.filter((s) => s.trigger === 'device') },
] as const;

const VERDICTS: Verdict[] = ['valid', 'warning', 'invalid', 'unverifiable'];
const OUTCOMES: CheckOutcome[] = ['pass', 'warn', 'fail', 'skipped'];
const SEVERITIES: Severity[] = ['info', 'warning', 'critical'];
const KINDS: DiscrepancyKind[] = ['label_mismatch', 'seal_damaged', 'suspected_copy', 'wrong_location', 'already_scanned', 'other'];
const UNIT_FIELDS = ['product', 'presentation', 'brand', 'category', 'issuer', 'lot', 'origin', 'producedAt', 'stage', 'destination', 'lastEvent', 'scans', 'lastScan'] as const;
const verifyPath = route(locale, 'verify');
---

<section
  class="verify-app"
  data-verify-app
  data-state="idle"
  data-locale={locale}
  data-default-tenant={defaultTenant.id}
  data-show-cobrand={env.showCobrandExample ? 'true' : 'false'}
  data-tenant={defaultTenant.id !== 'traza' ? defaultTenant.id : undefined}
  aria-label={t.a11y.toolRegion}
>
  <script type="application/json" is:inline data-verify-strings set:html={stringsJson} />

  <!-- Contexto del tenant (co-brand condicional) -->
  <div class="verify-context" data-tenant-context role="region" aria-label={t.tenant.regionLabel}>
    <div class="verify-context__brand">
      {
        tenantsWithLockup.map((x) => (
          <div class="verify-context__lockup" data-tenant-lockup={x.id} hidden={x.id !== defaultTenant.id}>
            <Lockup tenant={x} locale={locale} size="md" showNotice={true} />
            <p class="verify-context__caption">{t.tenant.lockupCaption}</p>
          </div>
        ))
      }
      <p class="verify-context__name">
        <span data-tenant-text="name">{defaultTenant.name[locale]}</span>
        <StatusPill tone="info" icon="flag" size="sm" class="verify-context__status">
          <span data-tenant-text="statusLabel">{defaultTenant.statusLabel[locale]}</span>
        </StatusPill>
      </p>
      <p class="verify-context__text" data-tenant-text="verifyContext">{defaultTenant.verifyContext[locale]}</p>
      <p class="verify-context__registry">
        <span class="verify-context__label">{t.tenant.registryLabel}:</span>
        <span class="mono" data-tenant-text="registryName">{defaultTenant.registryName[locale]}</span>
      </p>
    </div>
    <nav class="verify-context__switch" aria-label={t.tenant.switchLabel}>
      <span class="verify-context__label">{t.tenant.switchLabel}</span>
      <ul class="verify-context__options">
        {
          t.tenant.options.map((o) => (
            <li>
              <a
                class="verify-context__option"
                href={`${verifyPath}?t=${o.id}`}
                data-tenant-link={o.id}
                data-testid={`tenant-${o.id}`}
                aria-current={o.id === defaultTenant.id ? 'true' : undefined}
              >
                {o.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="verify-layout">
    <!-- Escáner -->
    <section class="verify-panel verify-scanner" aria-labelledby="verify-scanner-title" data-scanner data-camera="idle">
      <h2 id="verify-scanner-title" class="verify-panel__title">
        <Icon name="scan" size={22} class="verify-panel__icon" />
        {t.scanner.title}
      </h2>
      <p class="verify-panel__intro">{t.scanner.intro}</p>

      <div class="scanner__stage">
        <div class="scanner__viewer" data-viewer aria-hidden="true">
          <div class="scanner__motif"><QrMotif density="mid" /></div>
          <video class="scanner__video" data-video playsinline muted autoplay hidden></video>
          <span class="scanner__corner scanner__corner--tl"></span>
          <span class="scanner__corner scanner__corner--tr"></span>
          <span class="scanner__corner scanner__corner--bl"></span>
          <span class="scanner__corner scanner__corner--br"></span>
          <div class="scan-beam"></div>
        </div>
        <p class="scanner__code mono" aria-hidden="true" data-scanner-code>{FEATURED_UNIT_CODE}</p>
      </div>

      <p class="scanner__status" role="status" data-scanner-status data-testid="scanner-status">{t.scanner.idle}</p>

      <div class="scanner__device" data-device="denied" data-testid="verify-error" data-kind="camera-denied" hidden>
        <Callout tone="warning" icon="camera" title={t.scanner.denied.title} role="alert">
          <p>{t.scanner.denied.body}</p>
          <div class="cluster scanner__device-actions">
            <Button type="button" variant="secondary" size="sm" icon="camera" iconPosition="start" data-action="camera">{t.scanner.retryCamera}</Button>
            <Button type="button" variant="ghost" size="sm" icon="arrow-right" data-action="type">{t.scanner.typeInstead}</Button>
          </div>
        </Callout>
      </div>
      <div class="scanner__device" data-device="unavailable" data-testid="verify-error" data-kind="camera-unavailable" hidden>
        <Callout tone="neutral" icon="camera" title={t.scanner.unavailable.title} role="alert">
          <p>{t.scanner.unavailable.body}</p>
          <div class="cluster scanner__device-actions">
            <Button type="button" variant="secondary" size="sm" icon="arrow-right" data-action="type">{t.scanner.typeInstead}</Button>
          </div>
        </Callout>
      </div>
      <div class="scanner__device" data-device="unreadable" data-testid="verify-error" data-kind="unreadable" hidden>
        <Callout tone="warning" icon="qr" title={t.scanner.unreadable.title} role="alert">
          <p>{t.scanner.unreadable.body}</p>
          <div class="cluster scanner__device-actions">
            <Button type="button" variant="secondary" size="sm" icon="camera" iconPosition="start" data-action="camera">{t.scanner.retryCamera}</Button>
            <Button type="button" variant="ghost" size="sm" icon="arrow-right" data-action="type">{t.scanner.typeInstead}</Button>
          </div>
        </Callout>
      </div>

      <div class="cluster scanner__actions">
        <Button type="button" icon="scan" iconPosition="start" data-action="simulate" data-testid="simulate-scan">{t.scanner.simulate}</Button>
        <Button type="button" variant="secondary" icon="camera" iconPosition="start" data-action="camera" data-testid="use-camera">{t.scanner.useCamera}</Button>
        <Button type="button" variant="secondary" icon="x" iconPosition="start" data-action="stop-camera" data-testid="stop-camera" hidden>{t.scanner.stopCamera}</Button>
      </div>
      <p class="scanner__privacy">
        <Icon name="lock" size={14} />
        {t.scanner.privacyNote}
      </p>
    </section>

    <!-- Entrada manual -->
    <section class="verify-panel verify-manual" aria-labelledby="verify-manual-title">
      <h2 id="verify-manual-title" class="verify-panel__title">
        <Icon name="qr" size={22} class="verify-panel__icon" />
        {t.manual.title}
      </h2>
      <form class="verify-form" data-verify-form method="get" action={verifyPath} novalidate>
        <label class="field__label" for="verify-code">{t.manual.label}</label>
        <p id="verify-code-hint" class="field__hint">{t.manual.hint}</p>
        <div class="verify-form__row">
          <input
            id="verify-code"
            class="verify-form__input"
            name="c"
            type="text"
            inputmode="text"
            autocapitalize="off"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            maxlength="80"
            placeholder={t.manual.placeholder}
            aria-describedby="verify-code-hint"
            data-manual-input
            data-testid="manual-input"
          />
          <Button type="submit" icon="arrow-right" data-testid="verify-button">{t.manual.submit}</Button>
        </div>
        <p id="verify-code-error" class="field__error" role="alert" data-manual-error data-testid="manual-error" hidden></p>
        <p class="visually-hidden" role="status" data-manual-normalized></p>
        <noscript>
          <p class="verify-form__noscript">{t.manual.noscript}</p>
        </noscript>
      </form>
    </section>

    <!-- Salida: conectividad, resultado, reporte -->
    <div class="verify-output" data-output>
      <div class="verify-net" data-net-status aria-live="polite">
        <div data-net="offline" data-testid="net-offline" hidden>
          <Callout tone="warning" icon="offline" title={t.states.offlineBanner.title}>
            <p>{t.states.offlineBanner.body}</p>
          </Callout>
        </div>
        <div data-net="recovered" data-testid="net-recovered" hidden>
          <Callout tone="success" icon="refresh" title={t.states.recovered.title}>
            <p>
              {t.states.recovered.body}
              <span data-net-retrying hidden>{t.states.retryingPending}</span>
            </p>
          </Callout>
        </div>
      </div>

      <section class="verify-panel verify-result-panel" aria-label={t.a11y.resultRegion}>
        <div class="verify-views" data-result-region aria-live="polite" aria-busy="false">
          <!-- Vacío -->
          <div class="verify-empty" data-view="idle" data-testid="verify-idle">
            <span class="verify-empty__icon" aria-hidden="true"><Icon name="shield" size={32} /></span>
            <h2 class="verify-empty__title">{t.states.idle.title}</h2>
            <p class="verify-empty__body">{t.states.idle.body}</p>
          </div>

          <!-- Cargando -->
          <div class="verify-loading" data-view="loading" data-testid="verify-loading" hidden>
            <h2 class="verify-loading__title">{t.states.loading.title}</h2>
            <p class="verify-loading__body">{t.states.loading.body}</p>
            <div class="skeleton" aria-hidden="true">
              <span class="skeleton__bar skeleton__bar--pill"></span>
              <span class="skeleton__bar skeleton__bar--title"></span>
              <span class="skeleton__bar"></span>
              <span class="skeleton__bar skeleton__bar--short"></span>
              <span class="skeleton__row"></span>
              <span class="skeleton__row"></span>
              <span class="skeleton__row"></span>
              <span class="skeleton__row"></span>
            </div>
            <span class="visually-hidden">{t.a11y.skeleton}</span>
          </div>

          <!-- Error de transporte (no verificable) -->
          <div class="verify-error" data-view="error" data-testid="verify-error" data-kind="" data-verdict="unverifiable" data-reason="" role="alert" hidden>
            <div class="verify-error__icons" aria-hidden="true">
              <span class="verify-error__icon" data-error-icon="offline"><Icon name="offline" size={26} /></span>
              <span class="verify-error__icon" data-error-icon="server"><Icon name="server" size={26} /></span>
              <span class="verify-error__icon" data-error-icon="timeout"><Icon name="clock" size={26} /></span>
              <span class="verify-error__icon" data-error-icon="network"><Icon name="plug" size={26} /></span>
              <span class="verify-error__icon" data-error-icon="aborted"><Icon name="x" size={26} /></span>
            </div>
            <div class="verify-error__pills">
              <StatusPill tone="neutral" icon="info">{t.verdicts.unverifiable.label}</StatusPill>
            </div>
            <h2 class="verify-error__title" tabindex="-1" data-error-title></h2>
            <p class="verify-error__body" data-error-body></p>
            <p class="verify-error__code">
              <span class="verify-error__label">{t.states.pendingCodeLabel}:</span>
              <code class="mono" data-error-code></code>
            </p>
            <p class="verify-error__note" data-error-note="auto" hidden>{t.states.autoRetryNote}</p>
            <p class="verify-error__note" data-error-note="transport" hidden>{t.states.transportCodeNote}</p>
            <p class="verify-error__nothing">{t.states.nothingChecked}</p>
            <div class="cluster">
              <Button type="button" icon="refresh" iconPosition="start" data-action="retry" data-testid="retry-button">{t.states.retry}</Button>
              <Button type="button" variant="secondary" data-action="another" data-testid="type-another">{t.states.typeAnother}</Button>
            </div>
          </div>

          <!-- Resultado -->
          <article class="result" data-view="result" data-testid="verify-result" data-verdict="" data-reason="" hidden>
            <header class="result__header">
              <div class="result__verdict-icons" aria-hidden="true">
                {
                  VERDICTS.map((v) => (
                    <span class="result__verdict-icon" data-verdict-icon={v}>
                      <Icon name={VERDICT_ICON[v]} size={28} />
                    </span>
                  ))
                }
              </div>
              <div class="result__pills">
                {
                  VERDICTS.map((v) => (
                    <StatusPill tone={VERDICT_TONE[v]} icon={VERDICT_ICON[v]} data-verdict-pill={v} data-testid="verdict-pill">
                      {t.verdicts[v].label}
                    </StatusPill>
                  ))
                }
              </div>
              <h2 class="result__title" tabindex="-1" data-result-title data-testid="result-title"></h2>
              <p class="result__explanation" data-result-explanation></p>
              <dl class="result__meta">
                <div class="result__meta-item">
                  <dt>{t.states.codeLabel}</dt>
                  <dd><code class="mono result__code" data-result-code data-testid="result-code"></code></dd>
                </div>
                <div class="result__meta-item">
                  <dt>{t.states.verifiedAtLabel}</dt>
                  <dd class="mono" data-result-verified-at></dd>
                </div>
                <div class="result__meta-item">
                  <dt>{t.states.registryLabel}</dt>
                  <dd data-result-registry></dd>
                </div>
              </dl>
              <p class="result__other-tenant" data-result-other-tenant hidden></p>
            </header>

            <section class="result__section" aria-labelledby="verify-checks-title">
              <h3 id="verify-checks-title" class="result__section-title">{t.checks.title}</h3>
              <p class="result__section-intro">{t.checks.intro}</p>
              <ul class="checks">
                {
                  CHECK_ORDER.map((key) => (
                    <li class="check" data-check={key} data-outcome="">
                      <span class="check__icons" aria-hidden="true">
                        {OUTCOMES.map((o) => (
                          <span class="check__icon" data-outcome-icon={o}>
                            <Icon name={OUTCOME_ICON[o]} size={18} />
                          </span>
                        ))}
                      </span>
                      <div class="check__body">
                        <div class="check__head">
                          <h4 class="check__title">{t.checks[key].title}</h4>
                          <span class="check__outcome">
                            {OUTCOMES.map((o) => (
                              <span class="check__outcome-label" data-outcome-label={o}>
                                {t.checks.outcomes[o]}
                              </span>
                            ))}
                          </span>
                        </div>
                        <p class="check__help">{t.checks[key].help}</p>
                        <p class="check__status" data-check-status></p>
                        <p class="check__note" data-check-note hidden></p>
                        <dl class="check__details" data-check-details hidden></dl>
                        {key === 'anomalies' && <ul class="anomalies" data-check-anomalies hidden></ul>}
                      </div>
                    </li>
                  ))
                }
              </ul>
            </section>

            <section class="result__section" data-result-unit aria-labelledby="verify-unit-title" hidden>
              <h3 id="verify-unit-title" class="result__section-title">{t.unit.title}</h3>
              <dl class="unit">
                {
                  UNIT_FIELDS.map((f) => (
                    <div class="unit__item">
                      <dt>{t.unit[f]}</dt>
                      <dd data-unit={f}></dd>
                    </div>
                  ))
                }
              </dl>
            </section>
            <p class="result__unit-hidden" data-result-unit-hidden hidden>
              <Icon name="eye" size={16} />
              {t.unit.hiddenNote}
            </p>

            <section class="result__section result__meaning" aria-labelledby="verify-meaning-title">
              <h3 id="verify-meaning-title" class="result__section-title">{t.meaning.title}</h3>
              <p class="result__confidence">
                <strong>{t.meaning.confidenceLabel}:</strong>
                <span data-result-confidence data-testid="result-confidence"></span>
              </p>
              <h4 class="result__steps-title">{t.meaning.nextStepTitle}</h4>
              <ol class="result__steps" data-result-steps data-testid="result-steps"></ol>
              <p class="result__tenant-hint">
                <strong>{t.meaning.tenantHintLabel}:</strong>
                <span data-result-tenant-hint></span>
              </p>
            </section>

            <div class="cluster result__actions">
              <Button type="button" icon="flag" iconPosition="start" data-action="report" data-testid="report-button">{t.actions.report}</Button>
              <Button type="button" variant="secondary" icon="refresh" iconPosition="start" data-action="another" data-testid="verify-again">{t.actions.another}</Button>
            </div>
          </article>
        </div>

        <!-- Reporte de discrepancia -->
        <div class="verify-report" data-report-region aria-label={t.a11y.reportRegion} role="region" hidden>
          <form class="report-form" data-report-form data-testid="report-form" novalidate>
            <h2 class="report-form__title" tabindex="-1" data-report-title>{t.report.title}</h2>
            <p class="report-form__intro">{t.report.intro}</p>
            <p class="report-form__code">
              <span class="verify-error__label">{t.report.codeLabel}:</span>
              <code class="mono" data-report-code data-testid="report-code"></code>
            </p>

            <div class="field">
              <label class="field__label" for="report-kind">{t.report.kindLabel}</label>
              <select id="report-kind" class="field__control" name="kind" required aria-describedby="report-kind-error" data-report-kind data-testid="report-kind">
                <option value="">{t.report.kindPlaceholder}</option>
                {KINDS.map((k) => <option value={k}>{t.report.kinds[k]}</option>)}
              </select>
              <p id="report-kind-error" class="field__error" role="alert" data-field-error="kind" hidden>{t.report.errors.kind}</p>
            </div>

            <div class="field">
              <label class="field__label" for="report-description">{t.report.descriptionLabel}</label>
              <p id="report-description-hint" class="field__hint">{t.report.descriptionHint}</p>
              <textarea
                id="report-description"
                class="field__control"
                name="description"
                rows="4"
                required
                minlength="10"
                maxlength="600"
                aria-describedby="report-description-hint report-description-count report-description-error"
                data-report-description
                data-testid="report-description"></textarea>
              <p id="report-description-count" class="field__counter mono" data-report-counter></p>
              <p id="report-description-error" class="field__error" role="alert" data-field-error="description" hidden></p>
            </div>

            <div class="field">
              <label class="field__label" for="report-location">
                {t.report.locationLabel}
                <span class="field__optional">({common.form.optional})</span>
              </label>
              <p id="report-location-hint" class="field__hint">{t.report.locationHint}</p>
              <input id="report-location" class="field__control" name="location" type="text" autocomplete="off" maxlength="120" aria-describedby="report-location-hint" data-report-location data-testid="report-location" />
            </div>

            <div class="field">
              <label class="field__label" for="report-email">
                {t.report.emailLabel}
                <span class="field__optional">({common.form.optional})</span>
              </label>
              <p id="report-email-hint" class="field__hint">{t.report.emailHint}</p>
              <input id="report-email" class="field__control" name="email" type="email" inputmode="email" autocomplete="email" maxlength="120" aria-describedby="report-email-hint report-email-error" data-report-email data-testid="report-email" />
              <p id="report-email-error" class="field__error" role="alert" data-field-error="email" hidden>{t.report.errors.email}</p>
            </div>

            <Callout tone="neutral" icon="lock" class="report-form__notes">
              <p>{t.report.dataNote}</p>
            </Callout>

            <div data-report-view="error" data-testid="report-error" data-kind="" role="alert" hidden>
              <Callout tone="danger" icon="alert">
                <p><strong data-report-error-title></strong></p>
                <p data-report-error-body></p>
              </Callout>
            </div>

            <div class="cluster report-form__actions">
              <Button type="submit" icon="arrow-right" data-report-submit data-testid="report-submit" disabled>
                <span data-report-submit-label data-idle={t.report.submit} data-sending={t.report.sending}>{t.report.submit}</span>
              </Button>
              <Button type="button" variant="ghost" data-action="report-cancel" data-testid="report-cancel">{t.report.cancel}</Button>
            </div>
          </form>

          <div class="report-success" data-report-view="success" data-testid="report-success" data-folio="" role="status" hidden>
            <div class="report-success__pills">
              <StatusPill tone="success" icon="check">{t.report.success.title}</StatusPill>
            </div>
            <h2 class="report-success__title" tabindex="-1" data-report-success-title>{t.report.success.title}</h2>
            <p>{t.report.success.body}</p>
            <dl class="result__meta">
              <div class="result__meta-item">
                <dt>{t.report.success.folioLabel}</dt>
                <dd><code class="mono report-success__folio" data-report-folio data-testid="report-folio"></code></dd>
              </div>
              <div class="result__meta-item">
                <dt>{t.report.success.receivedAtLabel}</dt>
                <dd class="mono" data-report-received-at></dd>
              </div>
              <div class="result__meta-item">
                <dt>{t.report.codeLabel}</dt>
                <dd><code class="mono" data-report-success-code></code></dd>
              </div>
            </dl>
            <h3 class="result__section-title">{t.report.success.nextTitle}</h3>
            <ol class="result__steps">
              {t.report.success.next.map((line) => <li>{line}</li>)}
