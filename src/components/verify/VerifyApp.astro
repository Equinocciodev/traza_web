            <div class="cluster">
              <Button type="button" variant="secondary" icon="arrow-right" data-action="report-done" data-testid="report-done">{t.report.success.done}</Button>
              <Button type="button" variant="ghost" icon="refresh" iconPosition="start" data-action="another">{t.actions.another}</Button>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Códigos de ejemplo -->
