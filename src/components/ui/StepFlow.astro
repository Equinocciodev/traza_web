---
import type { Step } from '@/content/types';
interface Props { items: Step[]; columns?: 2 | 3 | 4; headingLevel?: 2 | 3 | 4 }
const { items, columns = 3, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---
<ol class:list={['flow', `flow--${columns}`]}>
  {items.map((item, i) => <li><span class="flow__num" aria-hidden="true">{i + 1}</span><Heading>{item.title}</Heading><p>{item.body}</p></li>)}
</ol>
<style>
  .flow { --flow-gap: 2rem; list-style: none; padding: 0; margin: 0; display: grid; gap: var(--flow-gap); }
  .flow li { position: relative; min-width: 0; padding-left: 3rem; }
  .flow__num { position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--color-cobalt-600); color: var(--color-white); font: 500 .8125rem var(--font-mono); z-index: 1; }
  .flow li:not(:last-child)::after { content: ''; position: absolute; left: 15.5px; top: 32px; bottom: calc(-1 * var(--flow-gap)); width: 1px; background: var(--color-border-strong); }
  .flow h2, .flow h3, .flow h4 { margin: 0 0 .75rem; padding-top: .2rem; font-size: 1.25rem; line-height: 1.3; color: var(--color-heading); }
  .flow p { margin: 0; color: var(--color-text-secondary); line-height: 1.65; }
  @media (min-width: 50em) {
    .flow--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .flow--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .flow li { padding: 3.25rem 0 0; }
    .flow li:not(:last-child)::after { top: 15.5px; bottom: auto; left: 32px; width: calc(100% + var(--flow-gap) - 32px); height: 1px; }
    .flow--2 li:nth-child(2n)::after, .flow--3 li:nth-child(3n)::after, .flow--4 li:nth-child(4n)::after { display: none; }
  }
</style>
