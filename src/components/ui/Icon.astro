---
/**
 * Iconos de línea propios (24×24, trazo 1.75). Decorativos por defecto (aria-hidden);
 * pasa `label` para un icono con significado (se añade role="img" y <title>).
 */
import type { IconName } from '@/content/types';

interface Props {
  name: IconName;
  size?: number | string;
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, label, class: className, strokeWidth = 1.75 } = Astro.props;

const PATHS: Record<IconName, string> = {
