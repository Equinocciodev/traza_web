---
/**
 * Banda de cierre con título, texto y dos CTA sobre azul marino, con motivo QR discreto.
 */
import Button from './Button.astro';
import { ctaHref } from './cta';
import type { Cta } from '@/content/types';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
  title: string;
  body?: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
  id?: string;
  class?: string;
}
const { locale, title, body, primaryCta, secondaryCta, id = 'cta-title', class: className } = Astro.props;
---

<!-- Motion: el revelado va en el contenedor interior (copia y acciones escalonadas); el fondo azul y el motivo QR
     decorativo quedan siempre pintados, así un scroll rápido nunca deja un hueco blanco antes del pie. -->
<section class:list={['cta-band', 'on-dark', className]} aria-labelledby={id}>

  <div class="container cta-band__inner" data-reveal data-reveal-stagger>
    <div class="cta-band__copy">
      <h2 id={id} class="cta-band__title">{title}</h2>
      {body && <p class="cta-band__body">{body}</p>}
    </div>
    <div class="cta-band__actions cluster">
      <Button href={ctaHref(locale, primaryCta)} variant="pill" tone="onDark" size="lg" icon="arrow-right">
        {primaryCta.label}
      </Button>
      {
        secondaryCta && (
          <Button href={ctaHref(locale, secondaryCta)} variant="pill" tone="outline" size="lg">
            {secondaryCta.label}
          </Button>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--color-navy-950);
    border-top: 1px solid rgba(25, 200, 255, .35);
  }

  .cta-band__inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 60em) {
    .cta-band__inner {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
    .cta-band__actions {
      justify-content: flex-end;
    }
  }
  .cta-band__title {
    color: var(--color-white);
    font-size: clamp(2rem,3.6vw,3.25rem);
    margin-bottom: var(--space-3);
  }
  .cta-band__body {
    max-width: 58ch;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }
  .cta-band__actions {
    gap: var(--space-4);
  }
</style>
