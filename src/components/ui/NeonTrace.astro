---
import { withBase } from '@/i18n';
interface Props { variant?: 'orbit' | 'loop' | 'sweep' | 'connector'; tone?: 'dark' | 'light'; draw?: 'load' | 'view'; duration?: number }
const { variant = 'loop', tone = 'dark', draw } = Astro.props;
---
<img class:list={['neon-trace', `neon-trace--${variant}`, `neon-trace--${tone}`]}
  src={withBase('/images/integral-20260909/neon-v2.webp')}
  srcset={[480, 768, 1024, 1536].map(width => `${withBase(`/images/integral-20260909/neon-v2${width === 1536 ? '' : `-${width}`}.webp`)} ${width}w`).join(', ')}
  sizes="(max-width: 47.99em) 100vw, 60vw"
  width="1536" height="1024" alt="" aria-hidden="true" decoding="async" loading={draw === 'load' ? 'eager' : 'lazy'} />
<style>
  .neon-trace { display:block; width:100%; height:100%; object-fit:contain; pointer-events:none;  }
  .neon-trace--sweep { object-position:center bottom; }
  .neon-trace--connector { object-position:center; }
</style>
