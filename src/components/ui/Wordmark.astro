---
import { WORDMARK } from '@/brand/wordmark.mjs';
interface Props {
  size?: 'sm' | 'md' | 'lg';
  alt?: string;
  class?: string;
}
const { size = 'md', alt = WORDMARK.label, class: className } = Astro.props;
---
<span class:list={['wordmark', `wordmark--${size}`, className]} role="img" aria-label={alt}>
  <svg fill-rule="evenodd" viewBox={WORDMARK.viewBox} width={WORDMARK.width} height={WORDMARK.height} aria-hidden="true" focusable="false">
    {WORDMARK.paths.map((d: string) => <path d={d} />)}
    <path d={WORDMARK.registered} />
    <rect class="wordmark__underline" x={WORDMARK.underline.x} y={WORDMARK.underline.y} width={WORDMARK.underline.width} height={WORDMARK.underline.height} />
  </svg>
</span>
<style>
  .wordmark { display: inline-flex; width: calc(var(--wm-size, 1.5rem) * 3.44); flex: 0 0 auto; color: var(--color-heading); line-height: 1; }
  .wordmark svg { display: block; width: 100%; height: auto; overflow: visible; fill: currentColor; }
  .wordmark__underline { fill: var(--color-brand-accent, var(--color-cyan-400)); }
  .wordmark--sm { --wm-size: 1.25rem; }
  .wordmark--md { --wm-size: 1.5rem; }
  .wordmark--lg { --wm-size: 2.25rem; }
</style>
