---
/**
 * Los cuatro resultados posibles de una verificación, cada uno con su pastilla de estado (icono + texto).
 * Nunca comunica solo con color; el título del resultado es el texto de la pastilla.
 */
import StatusPill from './StatusPill.astro';

type OutcomeStatus = 'valid' | 'warning' | 'invalid' | 'unverifiable';

interface Props {
  outcomes: { status: OutcomeStatus; title: string; body: string }[];
  class?: string;
}
const { outcomes, class: className } = Astro.props;
const TONE: Record<OutcomeStatus, 'success' | 'warning' | 'danger' | 'neutral'> = {
  valid: 'success',
  warning: 'warning',
  invalid: 'danger',
  unverifiable: 'neutral',
};
---

<ul class:list={['outcomes', 'grid', className]} data-reveal data-reveal-stagger>
  {
    outcomes.map((outcome) => (
      <li class:list={['outcome', `outcome--${outcome.status}`]} data-status={outcome.status}>
        <h3 class="outcome__title">
          <StatusPill tone={TONE[outcome.status]} class="outcome__pill">
            {outcome.title}
          </StatusPill>
        </h3>
        <p class="outcome__body">{outcome.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .outcomes {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .outcome {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-left: 4px solid var(--outcome-accent, var(--color-border-strong));
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .outcome--valid {
    --outcome-accent: var(--color-success-solid);
  }
  .outcome--warning {
    --outcome-accent: var(--color-warning-solid);
  }
  .outcome--invalid {
    --outcome-accent: var(--color-danger-solid);
  }
  .outcome--unverifiable {
    --outcome-accent: var(--color-neutral-400);
  }
  .outcome__title {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }
  .outcome__title :global(.outcome__pill) {
    align-items: flex-start;
    white-space: normal;
    text-align: left;
    font-size: var(--text-base);
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-md);
  }
  .outcome__title :global(.outcome__pill .icon) {
    margin-top: 0.2em;
  }
  .outcome__body {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
