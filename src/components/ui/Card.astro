---
/**
 * Tarjeta de contenido. Con `href` toda la tarjeta enlaza (el título es el enlace real).
 */
import Icon from './Icon.astro';
import type { IconName } from '@/content/types';

interface Props {
  title?: string;
  icon?: IconName;
  href?: string;
  tag?: string;
  class?: string;
  headingLevel?: 2 | 3 | 4;
  tone?: 'default' | 'subtle' | 'outline';
}
const { title, icon, href, tag, class: className, headingLevel = 3, tone = 'default' } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<article class:list={['card', `card--${tone}`, { 'card--link': !!href, lift: !!href }, className]}>
  {(icon || tag) && (
    <div class="card__top">
      {icon && (
        <span class="card__icon" aria-hidden="true">
          <Icon name={icon} size={22} />
        </span>
      )}
      {tag && <span class="meta-tag">{tag}</span>}
    </div>
  )}
  {
    title && (
      <Heading class="card__title">
        {href ? (
          <a class="card__link" href={href}>
            {title}
          </a>
        ) : (
          title
        )}
      </Heading>
    )
  }
  <div class="card__body"><slot /></div>
  {href && <span class="card__arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .card--subtle {
    background: var(--color-bg-subtle);
    box-shadow: none;
  }
  .card--outline {
    background: transparent;
    box-shadow: none;
  }
  :global(.on-dark) .card {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow: none;
  }
  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--color-cobalt-50);
    color: var(--color-cobalt-600);
  }
  :global(.on-dark) .card__icon {
    background: rgba(25, 200, 255, 0.12);
    color: var(--color-cyan-300);
  }
  .card__title {
    margin: 0;
    font-size: var(--text-lg);
  }
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card__link:focus-visible::after {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .card--link:hover .card__title {
    color: var(--color-link);
  }
  .card__body {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
  }
  .card__body :global(ul) {
    padding-left: 1.1em;
    margin: 0;
  }
  .card__body :global(li + li) {
    margin-top: var(--space-1);
  }
  .card__arrow {
    margin-top: auto;
    color: var(--color-link);
    align-self: flex-end;
  }
</style>
