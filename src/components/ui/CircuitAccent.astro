---
/**
 * Acento de "nodos y líneas de circuito" para el hero: líneas finas con nodos, decorativo (aria-hidden).
 * Pensado para envolver una tarjeta: el área central del viewBox (x 40–520, y 100–532) la cubre la
 * tarjeta y las líneas salen de sus bordes hacia fuera (márgenes: 40 izq., 120 der., 100 arriba/abajo).
 * Solo se usa en el hero (nunca como fondo constante). Motion (src/lib/motion.ts → observeTraceLines):
 * `data-trace-draw="load"` dibuja los `data-trace-path` una sola vez al cargar (≤ 900 ms, stroke-dashoffset)
 * únicamente en ≥ 64em (`data-trace-media`); el hero se pinta completo en servidor (sin JS, con reduced
 * motion o en móvil los trazos son estáticos) y al terminar se retiran los guiones.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['circuit', className]}
  viewBox="0 0 640 632"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="none"
  data-trace-draw="load"
  data-trace-media="(min-width: 64em)"
>
  <g class="circuit__lines" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
    <path data-trace-path d="M140 104 V44 H260"></path>
    <path data-trace-path d="M380 104 V24 H470"></path>
    <path data-trace-path d="M516 180 H600"></path>
    <path data-trace-path d="M516 300 H570 V360 H620"></path>
    <path data-trace-path d="M516 440 H610"></path>
    <path data-trace-path d="M220 528 V590 H350"></path>
    <path data-trace-path d="M440 528 V612"></path>
    <path data-trace-path d="M44 240 H6"></path>
    <path data-trace-path d="M44 400 H12"></path>
  </g>
  <g class="circuit__nodes" stroke-width="1.5">
    <circle cx="260" cy="44" r="4"></circle>
    <circle cx="470" cy="24" r="4"></circle>
    <circle cx="600" cy="180" r="4"></circle>
    <circle cx="620" cy="360" r="4"></circle>
    <circle cx="610" cy="440" r="4"></circle>
    <circle cx="350" cy="590" r="4"></circle>
    <circle cx="440" cy="612" r="4"></circle>
    <circle cx="6" cy="240" r="4"></circle>
    <circle cx="12" cy="400" r="4"></circle>
  </g>
  <g class="circuit__dots">
    <circle cx="140" cy="96" r="2.5"></circle>
    <circle cx="380" cy="96" r="2.5"></circle>
    <circle cx="524" cy="180" r="2.5"></circle>
    <circle cx="524" cy="300" r="2.5"></circle>
    <circle cx="524" cy="440" r="2.5"></circle>
    <circle cx="220" cy="536" r="2.5"></circle>
    <circle cx="440" cy="536" r="2.5"></circle>
    <circle cx="36" cy="240" r="2.5"></circle>
    <circle cx="36" cy="400" r="2.5"></circle>
  </g>
</svg>

<style>
  .circuit {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    pointer-events: none;
  }
  .circuit__lines {
    fill: none;
    stroke: var(--color-cyan-400);
    opacity: 0.6;
  }
  .circuit__lines path {
    vector-effect: non-scaling-stroke;
  }
  /* Capa propia solo mientras se dibujan los trazos (la clase la pone y quita JS). */
  .circuit.is-drawing {
    will-change: transform;
  }
  .circuit__nodes {
    fill: var(--color-navy-900);
    stroke: var(--color-cyan-400);
    opacity: 0.95;
  }
  .circuit__nodes circle {
    vector-effect: non-scaling-stroke;
  }
  .circuit__dots {
    fill: var(--color-cyan-400);
  }
</style>
