---
/**
 * Indicador discreto "Demostración conceptual — datos simulados".
 * - Franja superior estática (todas las pantallas): nunca tapa contenido.
 * - Insignia fija en la esquina inferior derecha solo en pantallas anchas (≥ 64em), sin capturar
 *   eventos de puntero; en móvil se omite para no cubrir texto ni controles.
 * Ambas son un landmark complementario con nombre accesible.
 */
import Icon from './Icon.astro';
import type { CommonContent } from '@/content/types';

interface Props {
  content: CommonContent['demoBadge'];
  variant: 'strip' | 'floating';
}
const { content, variant } = Astro.props;
---

{
  variant === 'strip' ? (
    <aside class="demo-strip" aria-label={content.long}>
      <div class="container demo-strip__inner">
        <Icon name="info" size={14} />
        <span class="demo-strip__long">{content.long}</span>
        <span class="demo-strip__short">{content.short}</span>
        <span class="visually-hidden">{content.explain}</span>
      </div>
    </aside>
  ) : (
    <div class="demo-badge" aria-hidden="true">
      <Icon name="info" size={16} />
      <span>{content.long}</span>
    </div>
  )
}

<style>
  .demo-strip {
    background: var(--color-navy-950);
    color: rgba(255, 255, 255, 0.86);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
  }
  .demo-strip__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 1.75rem;
    justify-content: center;
  }
  .demo-strip__short {
    display: none;
  }
  @media (max-width: 40em) {
    .demo-strip__long {
      display: none;
    }
    .demo-strip__short {
      display: inline;
    }
  }
  .demo-badge {
    display: none;
  }
  @media (min-width: 64em) {
    .demo-badge {
      position: fixed;
      right: var(--space-3);
      bottom: var(--space-3);
      z-index: var(--z-toast);
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: 0.375rem 0.75rem;
      border: var(--border-width) solid var(--color-border-strong);
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.92);
      color: var(--color-text-secondary);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.02em;
      box-shadow: var(--shadow-sm);
      pointer-events: none;
      backdrop-filter: blur(4px);
    }
  }
  @media print {
    .demo-badge {
      display: none;
    }
  }
</style>
