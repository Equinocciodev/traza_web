---
/**
 * Layout base: metadatos SEO/OG/hreflang, fuentes autoalojadas, estilos globales, skip link,
 * cabecera y pie. Sin scripts inline (compatible con CSP estricta);
 * el único bloque inline es el JSON-LD (bloque de datos, no ejecutable).
 */
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-600.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/roboto-mono/latin-400.css';
import '@fontsource/roboto-mono/latin-500.css';
// Brand contours are traced from the supplied reference, independently of interface fonts.
import '@fontsource/poppins/latin-700.css';
import headingFont from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/roboto/files/roboto-latin-400-normal.woff2?url';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/motion.css';

import Header from '@/components/site/Header.astro';
import HeaderV2 from '@/components/site/HeaderV2.astro';
import Footer from '@/components/site/Footer.astro';
import { getContent } from '@/content';
import { env, contactEmailFor } from '@/config/env';
import { withBase, LOCALES, LOCALE_LABELS, ROUTES, type Locale, type RouteKey } from '@/i18n';
import type { TenantId } from '@/config/tenants';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  /** Ruta absoluta de la imagen OG (por defecto la genérica). */
  ogImage?: string;
  noindex?: boolean;
  tenant?: TenantId;
  bodyClass?: string;
  /** V2 editorial header and in-hero disclosure; other routes retain the v1 shell. */
  homeV2?: boolean;
  /** Tipo de página para JSON-LD (WebPage por defecto). */
  schemaType?: 'WebPage' | 'AboutPage' | 'ContactPage';
}

const {
  locale,
  routeKey,
  title,
  description,
  ogImage = withBase('/og/integral-v2.png'),
  noindex = false,
  tenant,
  bodyClass,
  homeV2 = false,
  schemaType = 'WebPage',
} = Astro.props;

const content = getContent(locale);
const { common } = content;
const fullTitle = routeKey === 'home' ? common.meta.homeTitle : common.meta.titleTemplate.replace('%s', title);
const siteUrl = env.siteUrl;
const canonicalPath = routeKey === 'notFound' ? ROUTES[locale].home : ROUTES[locale][routeKey];
const canonical = new URL(withBase(canonicalPath), siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const alternates = LOCALES.map((l) => ({ locale: l, href: new URL(withBase(ROUTES[l][routeKey === 'notFound' ? 'home' : routeKey]), siteUrl).toString() }));

/**
 * Perfiles públicos y datos identificativos de la empresa. Se declaran una sola vez aquí
 * y viajan en el `@graph` de todas las páginas: buscadores y redes los leen del mismo sitio.
 */
const SAME_AS = ['https://www.instagram.com/traza.technology/'];

const organization = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: common.meta.siteName,
  legalName: 'Traza Technology, C.A.',
  url: siteUrl,
  slogan: common.brand.tagline,
  description: common.meta.defaultDescription,
  // `logo` debe ser el logotipo en sí (cuadrado, ≥112 px), no la tarjeta social 1200×630:
  // esa se declara aparte como `image`, que es la que usan las previsualizaciones.
  logo: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#logo`,
    url: new URL(withBase('/icon-512.png'), siteUrl).toString(),
    contentUrl: new URL(withBase('/icon-512.png'), siteUrl).toString(),
    width: 512,
    height: 512,
    caption: common.meta.siteName,
  },
  image: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#social-image`,
    url: new URL(withBase('/og/integral-v2.png'), siteUrl).toString(),
    contentUrl: new URL(withBase('/og/integral-v2.png'), siteUrl).toString(),
    width: 1200,
    height: 630,
    caption: common.meta.siteName,
  },
  sameAs: SAME_AS,
  // El buzón depende del idioma de la página: el JSON-LD declara el que corresponde a esta,
  // y `contactPoint` deja constancia del idioma en que se atiende.
  ...(contactEmailFor(locale)
    ? {
        email: contactEmailFor(locale),
        contactPoint: [
          {
            '@type': 'ContactPoint',
            contactType: 'sales',
            email: contactEmailFor(locale),
            availableLanguage: [LOCALE_LABELS[locale].htmlLang],
          },
        ],
      }
    : {}),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: common.meta.siteName,
      description: common.meta.defaultDescription,
      inLanguage: LOCALES.map((l) => LOCALE_LABELS[l].htmlLang),
      publisher: { '@id': `${siteUrl}/#organization` },
      copyrightHolder: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': schemaType,
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: LOCALE_LABELS[locale].htmlLang,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${siteUrl}/#organization` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
    },
  ],
};
---

<!doctype html>
<html lang={LOCALE_LABELS[locale].htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={LOCALE_LABELS[alt.locale].htmlLang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    {
      /*
       * La ausencia de `noindex` ya significa indexable, así que la directiva positiva es
       * redundante para el rastreador. Se emite igualmente por dos razones: deja la intención
       * escrita, y `max-image-preview:large` sí cambia algo — autoriza a Google a mostrar la
       * imagen grande en los resultados en lugar de una miniatura.
       */
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }
    <meta name="theme-color" content="#0b1f3f" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <meta name="apple-mobile-web-app-title" content={common.meta.siteName} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={common.meta.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={common.meta.ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={LOCALE_LABELS[locale].ogLocale} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALE_LABELS[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={[bodyClass]} data-tenant={tenant && tenant !== 'traza' ? tenant : undefined}>
    <a class="skip-link" href="#main">{common.skipLink}</a>
    {homeV2 ? <HeaderV2 locale={locale} common={common} /> : <Header locale={locale} routeKey={routeKey} common={common} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} routeKey={routeKey} common={common} />
  </body>
</html>

<script>
  import { initMotion } from '@/lib/motion';
  import { track } from '@/lib/analytics';
  import { initLookupLanguage } from '@/lib/lookup-language';
  initLookupLanguage();
  initMotion();
  track('page_view');
</script>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
  main {
    flex: 1 0 auto;
    outline: none;
  }
</style>
