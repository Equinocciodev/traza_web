{
  "name": "traza-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio web de Traza® — identidad digital y verificación de productos.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y",
    "screenshots": "playwright test --project=screenshots",
    "lighthouse": "node scripts/lighthouse.mjs",
    "og": "node scripts/og-image.mjs",
    "verify": "npm run check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^7.3.1",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
